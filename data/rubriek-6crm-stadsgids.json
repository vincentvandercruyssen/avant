      "evaluations": {
        "0b6de5c593": {
          "criteriaLevels": {},
          "feedback": "Knap resultaat! Je hebt het grootste deel vlekkeloos beet. Let er enkel op dat je voor een elementselector geen punt gebruikt (.section is een class) en dat de algemene stijlen op de body horen.\n\nJe toetsscore telt mee voor technieken (CRS02), webtoepassingen (CRS18) en vaktaal (13.08).",
          "scores": {
            "4.1": 10,
            "4.3": 10,
            "4.4": 10
          }
        },
        "37bc16a272": {
          "criteriaLevels": {},
          "feedback": "Dit kun je veel beter. De inhoudsverdeling en het nav-element herken je al goed. Je valt uit bij de schrijfwijze van hyperlinks (de a-tag met het href-attribuut), de elementselectoren en het boxmodel. Neem de leerstof nog eens grondig door en bekijk telkens in de planner wat er verwacht wordt te kennen.\n\nJe toetsscore telt mee voor technieken (CRS02), webtoepassingen (CRS18) en vaktaal (13.08).",
          "scores": {
            "4.1": 4,
            "4.3": 4,
            "4.4": 4
          }
        },
        "bfa5afc5c6": {
          "criteriaLevels": {},
          "feedback": "Goede inzet, de basis en de CSS-schrijfwijze zitten al goed. Onthoud dat een ID altijd uniek moet zijn op een pagina. Bekijk nog eens hoe je een a-element schrijft en herhaal het verschil tussen margin en padding.\n\nJe toetsscore telt mee voor technieken (CRS02), webtoepassingen (CRS18) en vaktaal (13.08).",
          "scores": {
            "4.1": 7.5,
            "4.3": 7.5,
            "4.4": 7.5
          }
        },
        "d1effb49ee": {
          "criteriaLevels": {},
          "feedback": "Afwezig tijdens het afnemen van de toets.",
          "scores": {}
        }
      }
